# ---------- Claude API（②抽出） ----------
ANTHROPIC_API_KEY=sk-ant-...
EXTRACTION_MODEL=claude-opus-5
EXTRACTION_EFFORT=high            # low | medium | high | xhigh | max
EXTRACTION_CONFIDENCE_THRESHOLD=0.75

# ---------- Google 共通 ----------
# Gmail / Sheets はサービスアカウント + ドメイン全体の委任、
# または OAuth ユーザー同意フローのどちらか。運用形態に合わせて片方だけ設定する。
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/gcp-sa.json
GOOGLE_IMPERSONATE_SUBJECT=info@example.co.jp   # ドメイン委任時に代理するユーザー
GOOGLE_OAUTH_CLIENT_SECRETS=/run/secrets/oauth_client.json
GOOGLE_OAUTH_TOKEN_PATH=/data/tokens/gmail_token.json

# ---------- ①Gmail ----------
GMAIL_LABEL_TARGET=物件情報          # 取り込み対象ラベル
GMAIL_LABEL_DONE=物件情報/処理済     # 処理後に付けるラベル
GMAIL_LABEL_ERROR=物件情報/エラー
GMAIL_MAX_RESULTS=50
ATTACHMENT_STORAGE_DIR=/data/attachments

# ---------- ③Google Sheets ----------
SHEETS_SPREADSHEET_ID=1AbC...
SHEETS_WORKSHEET_NAME=物件一覧
SHEETS_HEADER_ROW=1
SHEETS_COLUMN_MAP=/app/config/column_map.yaml

# ---------- ④Google Maps Platform ----------
GOOGLE_MAPS_API_KEY=AIza...
GEO_WALK_METERS_PER_MINUTE=80        # 公正競争規約：道路距離80m=1分
GEO_MAX_STATIONS=3
GEO_SEARCH_RADIUS_M=2000
GEO_CACHE_TTL_DAYS=90

# ---------- ⑤PPTX ----------
PPTX_TEMPLATE_MYSOKU=/app/templates/mysoku_a4.pptx
PPTX_TEMPLATE_SUMMARY=/app/templates/summary_a4.pptx
PPTX_OUTPUT_DIR=/data/documents
PPTX_IMAGE_MAX_PX=1600               # 長辺の上限。これ以上は縮小してから埋め込む
PPTX_IMAGE_JPEG_QUALITY=85

# ---------- インフラ ----------
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/realestate
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
