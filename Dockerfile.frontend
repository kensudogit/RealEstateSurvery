# フロントエンド。
#
# バックエンドと同じく、ビルドコンテキストは必ずリポジトリのルート。
# frontend/ の中に Dockerfile を置くと Railway がそれを拾って
# COPY package.json で失敗するため、ルートに置いてパスを明示する。
FROM node:22-alpine AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund


# --- ローカル開発用。ソースは compose がマウントする ---
FROM node:22-alpine AS dev
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
EXPOSE 3000
CMD ["npm", "run", "dev"]


FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
# NEXT_PUBLIC_ 接頭辞の変数はビルド時にバンドルへ埋め込まれる。
# Railway では「ビルド時の変数」として設定すること。実行時に変えても効かない。
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
RUN npm run build


# --- デプロイ用。next.config.mjs の output: "standalone" を使う ---
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
EXPOSE 3000
CMD ["sh", "-c", "node server.js"]
